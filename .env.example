# FreeSign 환경 변수 템플릿 — 이 파일은 커밋용(실제 값 금지).
# 실제 값은 .env.local 에 채운다.

# --- Supabase ---
# 브라우저 노출 가능(공개 값)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# service_role: CLI 시드에서만 사용. 요청 경로(app/api·Server Action)에서 절대 금지.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- Claude API ---
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- 앱 ---
# OAuth 리다이렉트·PDF 절대경로 등에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 결제(Polar) ---
# 대시보드 > Settings > API Keys 의 Organization Access Token
POLAR_ACCESS_TOKEN=<polar-access-token>
# Webhook 엔드포인트 설정 시 발급되는 서명 시크릿(어댑터의 서명 검증에 사용).
# 이 값은 반드시 DB billing_config 테이블에도 동일하게 주입해야 webhook RPC 가 열린다(0026):
#   insert into billing_config (id, webhook_secret) values (true, '<동일값>')
#     on conflict (id) do update set webhook_secret = excluded.webhook_secret;
# (Supabase postgres 롤은 커스텀 GUC ALTER 권한이 없어 GUC 대신 테이블에 저장한다.)
POLAR_WEBHOOK_SECRET=<polar-webhook-secret>
# 구독 상품(Pro) ID
POLAR_PRODUCT_ID=<polar-product-id>
# sandbox | production (미설정 시 sandbox)
POLAR_SERVER=sandbox
