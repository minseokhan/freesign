# FreeSign 환경 변수 템플릿 — 이 파일은 커밋용(실제 값 금지).
# 실제 값은 .env.local 에 채운다.

# --- Supabase ---
# 브라우저 노출 가능(공개 값)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# service_role: CLI 시드에서만 사용. 요청 경로(app/api·Server Action)에서 절대 금지.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- Claude API ---
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- 이메일(Resend) ---
# 미설정 시 발송은 콘솔 로그로 대체된다(개발 편의). 발송 실패는 항상 best-effort — 주 트랜잭션을 막지 않는다.
RESEND_API_KEY=<resend-api-key>
# 발신 주소. 미설정 시 Resend 테스트 주소(onboarding@resend.dev, 자기 계정 주소로만 발송 가능).
EMAIL_FROM=FreeSign <no-reply@example.com>

# --- 타임스탬프(RFC 3161 TSA) ---
# 미설정 시 기본 freeTSA.org. 국내 공인 TSA로 교체하려면 엔드포인트를 지정한다.
TSA_URL=

# --- 앱 ---
# OAuth 리다이렉트·PDF 절대경로 등에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 결제(Polar) ---
# 대시보드 > Settings > API Keys 의 Organization Access Token
POLAR_ACCESS_TOKEN=<polar-access-token>
# Webhook 엔드포인트 설정 시 발급되는 서명 시크릿(어댑터의 서명 검증에 사용).
# 이 값은 반드시 DB billing_config 테이블에도 동일하게 주입해야 webhook RPC 가 열린다(0026):
#   insert into billing_config (id, webhook_secret) values (true, '<동일값>')
#     on conflict (id) do update set webhook_secret = excluded.webhook_secret;
# (Supabase postgres 롤은 커스텀 GUC ALTER 권한이 없어 GUC 대신 테이블에 저장한다.)
POLAR_WEBHOOK_SECRET=<polar-webhook-secret>
# 구독 상품(Pro) ID
POLAR_PRODUCT_ID=<polar-product-id>
# sandbox | production (미설정 시 sandbox)
POLAR_SERVER=sandbox

# --- 크론(Vercel Cron) ---
# /api/cron/daily 인가 시크릿. Vercel Cron이 Authorization: Bearer <값>으로 호출한다.
# 이 값은 반드시 DB cron_config 테이블에도 동일하게 주입해야 크론 RPC가 열린다(0027):
#   insert into cron_config (id, cron_secret) values (true, '<동일값>')
#     on conflict (id) do update set cron_secret = excluded.cron_secret;
CRON_SECRET=<cron-secret>
